{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yukbul",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yukvinc-db",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "AI_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFix_9Aae1ng9JT8"
  },
  "routes": [
    { "pattern": "yukvinc.com.tr", "custom_domain": true },
    { "pattern": "www.yukvinc.com.tr", "custom_domain": true }
  ],
  "workers_dev": false
}
