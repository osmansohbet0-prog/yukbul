{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yukbul",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yukvinc-db",
      "database_id": "e7bba0a3-eb81-4122-9d16-7787d8fd531c",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 4 * * 1"] },
  "vars": {
    "AI_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFix_9Aae1ng9JT8"
  },
  "routes": [
    { "pattern": "yukvinc.com.tr", "custom_domain": true },
    { "pattern": "www.yukvinc.com.tr", "custom_domain": true }
  ],
  "workers_dev": false,
  "previews": {
    "vars": {
      "AI_ENABLED": "false",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFix_9Aae1ng9JT8"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "yukvinc-preview",
        "database_id": "fa5c7fc3-e0eb-4fb9-813d-0c696a05cff5",
        "migrations_dir": "migrations"
      }
    ],
    "ai": { "binding": "AI" }
  }
}