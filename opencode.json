{
  "$schema": "https://opencode.ai/config.json",
  "model": "evren/glm-5.3",
  "provider": {
    "evren": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "EVREN LLM (SAYZEK)",
      "options": {
        "baseURL": "https://evren-llmapi.ssyz.org.tr/v1",
        "apiKey": "{env:EVREN_LLM_API_KEY}",
        "headers": {
          "X-API-Key": "{env:EVREN_LLM_API_KEY}"
        }
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3 (EVREN)"
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (EVREN)"
        },
        "qwen3.8-flash-next": {
          "name": "Qwen 3.8 Flash Next (EVREN)"
        },
        "gemma-4-31b": {
          "name": "Gemma 4 31B (EVREN)"
        },
        "qwen3-vl-30b": {
          "name": "Qwen 3 VL 30B (EVREN)"
        }
      }
    }
  }
}
